<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 只需要联网 + 定位：联网只剩「检查更新」一个接口（GET /api/manifest），定位用于「定位到当前城市」。
         **没有 WAKE_LOCK / 后台服务 / 通知**：这个 app 不常驻后台、不发通知，
         所有操作都是用户点一下才发生。
         （2.1 加「自动记录」时会引入前台服务与通知权限，届时在这里补。） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 定位：打卡页的准心按钮与地图页的「我的位置」用（见 ui/Locate）。
         只要**粗略位置** —— 找最近的城市用不到米级精度，权限也更轻，
         所以 ACCESS_FINE_LOCATION 刻意不在清单里、也不请求。 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- android:name 指向 CityFootprintApp：它做三件事 —— 初始化 MapLibre、把用户选的
         外观交给 AppCompat、后台预热城市表。删掉这一行这三件事都不再发生
         （地图会在 inflate MapView 时直接崩）。 -->
    <application
        android:name=".CityFootprintApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CityFootprint"
        android:usesCleartextTraffic="false">
        <!-- 三个域名（通行证 / 网页 / 足迹接口）都是 HTTPS，所以**刻意没有**
             network_security_config 的明文例外；usesCleartextTraffic="false" 只是把这件事摆到明面上。 -->

        <!-- 主页：底部五个 tab（主页 / 行程 / 地图 / 成就 / 我的）。
             2.0 没有登录页 —— MainActivity 就是入口，数据全部来自本地库。
             singleTop + 不写 configChanges：旋转时重建，五个 Fragment 由 FragmentManager 自己恢复。 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 城市选择页：从 assets/cities.json 里搜城市，把城市名与坐标回传给调用方
             （手动打卡页 / 行程编辑器）。 -->
        <activity
            android:name=".ui.CityPickerActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- 手动打卡页：城市 + 四档日期精度 + 备注 -->
        <activity
            android:name=".ui.CheckinEditActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- 行程编辑器：标题 + 时间线事件列表 + 备注；保存时自动派生关联打卡 -->
        <activity
            android:name=".ui.TripEditActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
