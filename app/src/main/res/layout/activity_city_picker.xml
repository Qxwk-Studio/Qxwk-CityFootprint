<?xml version="1.0" encoding="utf-8"?>
<!-- 城市选择页的外壳：与其余三页共用同一份顶栏（view_top_bar.xml）。
     这一页设计稿里没有，所以不给它加底栏 —— 整页就是一个搜索结果列表，空间留给列表更实在。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- 标题文字与返回按钮都由 CityPickerActivity 填（共用顶栏不自带文案） -->
    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- 搜索框：直接一个输入框（提示语在框内），与其它表单同圆角 -->
    <EditText
        android:id="@+id/inputSearch"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:hint="@string/city_search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:textColor="@color/fg"
        android:textColorHint="@color/text_tertiary"
        android:textSize="14sp" />

    <!-- id=content 是给 edge-to-edge 用的：导航栏那截高度加到它的 paddingBottom 上，
         列表最后几行不会被手势条盖住（见 ui/EdgeToEdge.kt） -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cityList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/textCityEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/city_empty"
            android:textColor="@color/muted_fg"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
