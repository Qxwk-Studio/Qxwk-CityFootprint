<?xml version="1.0" encoding="utf-8"?>
<!-- 抽屉里的一行：一个栏目 = 一个网页（条目由 version.json 的 menu 渲染，见 MainActivity.renderMenu）。

     尺寸直接复用「我的」页那套 SettingsRow / SettingsRowCopy（52dp 起、左右 16dp、
     行尾一枚 18dp 箭头），但**字色不复用 SettingsRowTitle** —— 那个写死了 @color/fg（页面底上的正文色），
     这里的底是抽屉面板的 sidebar 底，语义色是「侧栏上的字」＝ sidebar_fg。
     眼下两个 token 恰好同值，将来调侧栏配色时才不会连正文一起带跑。

     整行可点 + 水波纹：与「我的」页的可点行同一写法（selectableItemBackground + clickable + focusable）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/SettingsRow"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout style="@style/SettingsRowCopy">

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/sidebar_fg"
            android:textSize="15sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_arrow_right"
        android:tint="@color/text_tertiary" />
</LinearLayout>
