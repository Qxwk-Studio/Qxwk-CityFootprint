<?xml version="1.0" encoding="utf-8"?>
<!-- 主页 = 网页端「足迹管理页」左栏的内容（板块对齐 docs/visits.html 的 .personal-layout 第一列）：
     「📢 有新公告」横幅（仅未读时出现）+「📊 足迹统计」五张小卡（首行「时间跨度」整行长卡，其余每行两个）
     +「📍 行程记录」列表。

     **整页一起滚**：页头（统计 + 行程记录标题行）做成列表的第 0 项（见 item_visits_overview.xml），
     由 ui/VisitsHeaderAdapter 与 VisitAdapter 一起交给 ConcatAdapter。
     这样全页只有 RecyclerView 一个滚动容器 —— 把 RecyclerView 塞进 NestedScrollView + wrap_content
     想让页头跟着一起滚的写法试过，嵌套测量下只量得出一条的高度，不可靠，别再试。

     横向 16dp 留白放在 RecyclerView 自己的 paddingStart/End 上（不是各 item 的 margin）：
     页头与足迹卡片因此天然对齐，也省得 item_visit.xml 再抄一遍。
     clipToPadding=false 让滚动到底时最后一条能滑进这圈留白里，不至于被硬切掉。 -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipe"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 中间垫一层 FrameLayout 是为了空态提示能居中浮在列表上。
         代价：SwipeRefreshLayout 判断「列表是否已经在上方」时看的是直接子 View（这层 FrameLayout），
         它不是滚动视图、永远答「没滚过」—— 于是列表滑到中间也能下拉刷出指示器。
         所以下面在代码里补 setOnChildScrollUpCallback，把判断交回真正的列表（见 VisitsFragment）。 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/textEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/visits_empty"
            android:textColor="@color/muted_fg"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>