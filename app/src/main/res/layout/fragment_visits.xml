<?xml version="1.0" encoding="utf-8"?>
<!-- 主页 = 网页端「足迹管理页」的内容（概览卡 + 标题行 + 足迹列表），样式按设计稿重做：
     圆角 8dp 描边卡片、11~16sp 的文字层级、主色「添加足迹」按钮（不再是 FAB）。

     列表就是普通的 RecyclerView（自己滚动），顶部的概览卡与标题行固定不动。
     （曾把 RecyclerView 塞进 NestedScrollView + wrap_content，想让卡片高度跟着条目数走，
     但在嵌套测量下只量得出一条的高度。RecyclerView 套在滚动容器里这写法不可靠，改回它自己当滚动容器。） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ===== 足迹统计概览 =====
         版面照网页端 docs/visits.html 的 .visit-stats：标题下一条分隔线，接着 2×2 网格，
         每格「小标签在上、主色大数字在下」，第四格是最早·最近那条区间。 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardOverview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/CardTitle"
                android:text="@string/visits_overview_title" />

            <!-- 网格整体：上方一条 1px 分隔线 + paddingTop，等价网页 .visit-stats 的 border-top -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/divider_top_bg"
                android:orientation="vertical"
                android:paddingTop="14dp">

                <!-- 第一行：去过城市 / 足迹 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/StatLabel"
                            android:layout_marginTop="0dp"
                            android:text="@string/visits_overview_cities" />

                        <TextView
                            android:id="@+id/valueCities"
                            style="@style/StatValue.Primary"
                            android:layout_marginTop="2dp"
                            android:text="0" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/StatLabel"
                            android:layout_marginTop="0dp"
                            android:text="@string/visits_overview_visits" />

                        <TextView
                            android:id="@+id/valueVisits"
                            style="@style/StatValue.Primary"
                            android:layout_marginTop="2dp"
                            android:text="0" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 第二行：覆盖省份 / 最早·最近 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/StatLabel"
                            android:layout_marginTop="0dp"
                            android:text="@string/visits_overview_provinces" />

                        <TextView
                            android:id="@+id/valueProvinces"
                            style="@style/StatValue.Primary"
                            android:layout_marginTop="2dp"
                            android:text="0" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/StatLabel"
                            android:layout_marginTop="0dp"
                            android:text="@string/visits_overview_range" />

                        <!-- 日期区间（形如 2019 → 2026-05）不是数字：与网页 .date-range 一样压小些，同用主色 -->
                        <TextView
                            android:id="@+id/valueRange"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="monospace"
                            android:maxLines="1"
                            android:text="—"
                            android:textColor="@color/accent"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===== 「我的足迹」标题行（左侧标题+条数说明，右侧主色「添加足迹」） ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/visits_title"
                android:textColor="@color/fg"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textListSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/muted_fg"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            style="@style/Widget.App.Button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/visits_add"
            android:textSize="13sp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="16dp" />
    </LinearLayout>

    <!-- ===== 足迹列表 ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp">

            <!-- 左右/底部外边距放在 SwipeRefreshLayout 上而不是 RecyclerView 上：
                 SwipeRefreshLayout 会忽略子 View 的 margin（下拉指示器按子 View 顶部定位），
                 放外面才有那圈留白；列表卡改用 bg_card 铺满这块区域。 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_card"
                android:clipToPadding="false" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/textEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/visits_empty"
            android:textColor="@color/muted_fg"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
