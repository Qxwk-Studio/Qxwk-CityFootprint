<?xml version="1.0" encoding="utf-8"?>
<!-- app 外壳（设计稿的 .app-board）：顶栏 + 内容 + 底部导航，三段纵向排布。
     顶栏与底栏都是设计稿的 sidebar 底色（浅蓝），内容区是 background 白。
     顶栏/底栏各有一条 1px 分隔线（都用 sidebar-border），与设计稿一致。
     原先顶部与底部导航之间还有一条品牌页脚，已按需求移除。

     顶栏右侧原先那颗「打开我的」动作按钮也已按需求移除：底部导航里本来就有「我的」，
     右上角再放一个头像是重复入口。

     ===== 最外层是抽屉 =====
     主页左上角那颗三横菜单（view_top_bar 的 btnMenu）点开的就是下面第二块 —— 左侧抽屉面板。
     抽屉里放的是「栏目」：一行 = 一个网页，条目由 version.json 的 menu 渲染（见 MainActivity.loadMenu）。

     两个**别顺手改**的地方：
      1. 主内容那层 LinearLayout **不能有 layout_gravity** —— DrawerLayout 正是靠
         「没有 layout_gravity 的子 View」认出主内容区的；加了就会被当成第二个抽屉，
         症状是整页只剩白底（内容面板被当成抽屉挪到屏幕外）。
      2. edge-to-edge 的监听挂在 DrawerLayout 这一层，不是挂在主内容那层
         （见 ui/EdgeToEdge.kt 的第 4 点：按子 View 顺序分发、先吃到 inset 的会挡住后面的）。 -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:orientation="vertical">

        <!-- ===== 顶栏 =====
             id=topBar 是给 edge-to-edge 用的：状态栏 / 刘海那截高度会加到这个容器的 paddingTop 上
             （见 ui/EdgeToEdge.kt）。顶栏底色与状态栏底色同为 sidebar，所以不必再设 android:statusBarColor。
             布局本体在 view_top_bar.xml（全 app 共用一份），标题文字由 MainActivity 按选中的 tab 填。 -->
        <include
            android:id="@+id/topBar"
            layout="@layout/view_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ===== 底部导航 ===== -->
        <!-- id=bottomBar 同上：手势条 / 虚拟导航栏那截高度加到 paddingBottom 上，
             底栏的 sidebar 底色顺势铺到屏幕最下边。容器形态与顶栏共用 Widget.App.ShellBand
             （分隔线朝上，也是 Widget.App.ShellDivider）。 -->
        <LinearLayout
            android:id="@+id/bottomBar"
            style="@style/Widget.App.ShellBand">

            <View style="@style/Widget.App.ShellDivider" />

            <!-- 五个 tab 都在 menu/bottom_nav.xml 里定义（图标 + 文案）；
                 选中态样式见 themes.xml 的 Widget.App.BottomNav（主色药丸 + 白字）。
                 高度不需要压到最紧，但 minHeight 仍必须在这里显式写死：不写就吃 M3 主题给
                 活动指示器（那颗药丸）留的默认最小值（56dp），比下面这几个值都大 ——
                 item 内边距收得再紧，也被那个下限顶回去，白调。
                 52dp 比 Material 的触摸目标下限（48dp）多 4dp，是给「图标 + 文案」留的呼吸。
                 item 多出来的高度不会跑到图标与文案之间 —— 文案已被 MainActivity.pinBottomNavLabels
                 贴到图标底下，富余高度只会落在文案下方。
                 两个 itemPadding 是 BottomNavigationView 自己的属性（app: 命名空间），
                 不是 android:padding —— 后者会被 item 的测量逻辑忽略。
                 itemPaddingTop 取 6dp：比原来的 4dp 多出的 2dp 落在图标上方，而 item 长高的 4dp
                 里另一半落到文案下方，整块内容才在 item 里居中（图标位置由 itemPaddingTop 决定）。

                 activeIndicatorLabelPadding 压成 0，只是为了别让它按 M3 默认的 4dp 抬高 item 的
                 最小高度（见 NavigationBarItemView.getSuggestedMinimumHeight）。它 **不是**
                 「图标与文案之间那条缝」的解 —— 那条缝的正主是 item 比内容高：material 1.11 的
                 item 是个 FrameLayout，图标容器贴顶（topMargin = itemPaddingTop）、文案组贴底
                 （paddingBottom = itemPaddingBottom），而 item 高度被上面的 minHeight 顶住，
                 多出来的那截高度就落在两者之间。属性层面动不了它（itemPaddingBottom 同时参与
                 最小高度计算，改它只是把留白搬家），实际修法见
                 MainActivity.pinBottomNavLabels() —— 运行时把文案组平移到图标底边。 -->
            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottomNav"
                style="@style/Widget.App.BottomNav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                app:itemIconSize="20dp"
                app:itemPaddingTop="6dp"
                app:itemPaddingBottom="4dp"
                app:activeIndicatorLabelPadding="0dp"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/bottom_nav" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== 左侧抽屉面板 ===== -->
    <!-- 宽 280dp（Material 建议的抽屉宽度，正好放得下「图标 + 一行中文标题」）；
         底色与顶栏同为 sidebar，拉出来像是从顶栏里长出来的一条。
         elevation 是给 DrawerLayout 画那条右边影用的 —— 抽屉子 View 只有设了 elevation
         才会被 DrawerLayout 当作「浮起来的层」画上阴影，不设就是两块白面糊在一起。
         面板自己不设 fitsSystemWindows：状态栏那截高度由 EdgeToEdge 加到它的 paddingTop 上，
         和顶栏同一套路，底色顺势铺满状态栏。 -->
    <LinearLayout
        android:id="@+id/drawerPanel"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/sidebar"
        android:elevation="8dp"
        android:orientation="vertical">

        <!-- 标题行：高度/内边距/字色都对齐顶栏，于是抽屉顶部与顶栏在同一条线上 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/menu_title"
                android:textColor="@color/sidebar_fg"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View style="@style/Widget.App.ShellDivider" />

        <!-- 条目列表（id=menuList）与空态文字（id=menuState）**互斥显示**：
             有栏目就只要列表，拉不到 / 一个栏目都没有就只要那行灰字。
             放在同一层、各自 weight=1，切换时不用管尺寸怎么分。 -->
        <ScrollView
            android:id="@+id/menuScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/menuList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/menuState"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textColor="@color/text_tertiary"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
