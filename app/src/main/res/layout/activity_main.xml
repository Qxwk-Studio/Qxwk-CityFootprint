<?xml version="1.0" encoding="utf-8"?>
<!-- app 外壳：顶栏 + 内容 + 底部导航，三段纵向排布。
     顶栏与底栏都是设计稿的 sidebar 底色，内容区是 background。
     edge-to-edge 的监听挂在最外这层上，一次把 inset 分给顶栏与底栏（见 ui/EdgeToEdge.kt）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/bottomBar"
        style="@style/Widget.App.ShellBand">

        <View style="@style/Widget.App.ShellDivider" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            style="@style/Widget.App.BottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:itemIconSize="20dp"
            app:itemPaddingTop="6dp"
            app:itemPaddingBottom="4dp"
            app:activeIndicatorLabelPadding="0dp"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav" />
    </LinearLayout>
</LinearLayout>
