<?xml version="1.0" encoding="utf-8"?>
<!-- app 外壳（设计稿的 .app-board）：顶栏 + 内容 + 底部导航，三段纵向排布。
     顶栏与底栏都是设计稿的 sidebar 底色（浅蓝），内容区是 background 白。
     顶栏/底栏各有一条 1px 分隔线（都用 sidebar-border），与设计稿一致。
     原先顶部与底部导航之间还有一条品牌页脚，已按需求移除。

     顶栏右侧原先那颗「打开我的」动作按钮也已按需求移除：底部导航里本来就有「我的」，
     右上角再放一个头像是重复入口。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- ===== 顶栏 =====
         id=topBar 是给 edge-to-edge 用的：状态栏 / 刘海那截高度会加到这个容器的 paddingTop 上
         （见 ui/EdgeToEdge.kt）。顶栏底色与状态栏底色同为 sidebar，所以不必再设 android:statusBarColor。
         布局本体在 view_top_bar.xml（全 app 共用一份），标题文字由 MainActivity 按选中的 tab 填。 -->
    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ===== 底部导航 ===== -->
    <!-- id=bottomBar 同上：手势条 / 虚拟导航栏那截高度加到 paddingBottom 上，
         底栏的 sidebar 底色顺势铺到屏幕最下边。容器形态与顶栏共用 Widget.App.ShellBand
         （分隔线朝上，也是 Widget.App.ShellDivider）。 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        style="@style/Widget.App.ShellBand">

        <View style="@style/Widget.App.ShellDivider" />

        <!-- 五个 tab 都在 menu/bottom_nav.xml 里定义（图标 + 文案）；
             选中态样式见 themes.xml 的 Widget.App.BottomNav（主色药丸 + 白字）。
             高度要压到最紧，所以 minHeight 必须在这里显式写死：不写就吃 M3 主题给
             活动指示器（那颗药丸）留的默认最小值，比下面这几个值都大 ——
             item 内边距收得再紧，也被那个下限顶回去，白调。
             48dp 是 Material 的触摸目标下限，再矮点着就不准了，所以收到这里为止。
             两个 itemPadding 是 BottomNavigationView 自己的属性（app: 命名空间），
             不是 android:padding —— 后者会被 item 的测量逻辑忽略。

             activeIndicatorLabelPadding 是「图标与文案之间那条缝」的正主，必须显式压到 0：
             material 1.11 的 item 是个 FrameLayout，图标容器贴顶（topMargin = itemPaddingTop）、
             文案组贴底（paddingBottom = itemPaddingBottom），而 item 的测量高度 **额外** 加了
             一段 activeIndicatorLabelPadding（M3 默认 4dp，见 NavigationBarItemView
             getSuggestedMinimumHeight）。那段高度落在图标与文案之间，表现就是
             「图标顶在上边、文字沉在下边、中间空一截」。压成 0 后这段高度不再存在，
             图标与文案就贴着排在上半部分，留白全部落到 item 底部 —— 即控件整体上对齐。
             注意 itemPaddingBottom 不是这条缝的解：它同时撑高 item，改它只会把留白搬家。 -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            style="@style/Widget.App.BottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:itemIconSize="20dp"
            app:itemPaddingTop="4dp"
            app:itemPaddingBottom="4dp"
            app:activeIndicatorLabelPadding="0dp"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav" />
    </LinearLayout>
</LinearLayout>
