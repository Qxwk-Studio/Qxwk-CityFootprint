<?xml version="1.0" encoding="utf-8"?>
<!-- app 外壳（设计稿的 .app-board）：顶栏 + 内容 + 底部导航，三段纵向排布。
     顶栏与底栏都是设计稿的 sidebar 底色（浅蓝），内容区是 background 白。
     顶栏/底栏各有一条 1px 分隔线（都用 sidebar-border），与设计稿一致。
     原先顶部与底部导航之间还有一条品牌页脚，已按需求移除。

     顶栏右侧原先那颗「打开我的」动作按钮也已按需求移除：底部导航里本来就有「我的」，
     右上角再放一个头像是重复入口。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- ===== 顶栏 =====
         id=topBar 是给 edge-to-edge 用的：状态栏 / 刘海那截高度会加到这个容器的 paddingTop 上
         （见 ui/EdgeToEdge.kt）。顶栏底色与状态栏底色同为 sidebar，所以不必再设 android:statusBarColor。
         布局本体在 view_top_bar.xml（全 app 共用一份），标题文字由 MainActivity 按选中的 tab 填。 -->
    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ===== 底部导航 ===== -->
    <!-- id=bottomBar 同上：手势条 / 虚拟导航栏那截高度加到 paddingBottom 上，
         底栏的 sidebar 底色顺势铺到屏幕最下边。容器形态与顶栏共用 Widget.App.ShellBand
         （分隔线朝上，也是 Widget.App.ShellDivider）。 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        style="@style/Widget.App.ShellBand">

        <View style="@style/Widget.App.ShellDivider" />

        <!-- 五个 tab 都在 menu/bottom_nav.xml 里定义（图标 + 文案）；
             选中态样式见 themes.xml 的 Widget.App.BottomNav（主色药丸 + 白字）。
             高度仍是 wrap_content（M3 的 56dp 只是 minHeight），但三处内边距从默认收紧：
               默认 itemPaddingTop 12dp / itemPaddingBottom 16dp / itemIconSize 24dp，
               加起来 ~66dp 高、图标与文字之间还空一大截；
               改成 6dp / 8dp / 22dp 后约 52dp，紧凑但不挤（图标与文案之间仍有呼吸）。
             两个 itemPadding 是 BottomNavigationView 自己的属性（app: 命名空间），
             不是 android:padding —— 后者会被 item 的测量逻辑忽略。 -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            style="@style/Widget.App.BottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:itemIconSize="22dp"
            app:itemPaddingTop="6dp"
            app:itemPaddingBottom="8dp"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav" />
    </LinearLayout>
</LinearLayout>
