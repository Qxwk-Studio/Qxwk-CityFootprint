<?xml version="1.0" encoding="utf-8"?>
<!-- 手动打卡页（2.0）：城市 + 到访时间（四档精度）+ 备注。
     与 1.x 的编辑页共用同一套「顶栏 include + 表单纵向排布」形态，但字段完全不同：
     1.x 是「城市 + 年月 + 备注 + 出行方式」，2.0 把出行方式移到了行程的时间线里。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 城市：不可手输，点一行选城，右侧准心按定位判城 -->
            <TextView
                style="@style/TextFormLabel"
                android:text="@string/checkin_city" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="4dp">

                <EditText
                    android:id="@+id/inputCity"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:clickable="false"
                    android:focusable="false"
                    android:hint="@string/checkin_city_hint"
                    android:inputType="none"
                    android:textColor="@color/fg"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btnLocate"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/checkin_locate"
                    android:padding="8dp"
                    android:src="@drawable/ic_locate"
                    android:tint="@color/accent" />
            </LinearLayout>

            <TextView
                android:id="@+id/textCityError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/destructive"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- 到访时间：年 / 月 / 日三个下拉 + 今天 + 记不清了（四档精度，见 logic/DatePrecision） -->
            <TextView
                style="@style/TextFormLabel"
                android:layout_marginTop="16dp"
                android:text="@string/checkin_date" />

            <!-- 三个下拉分两行摆：一行三个会把「仅到年份」「不记得日」这种长选项挤成省略号
                 （第一版就是那样，用户反馈排版有问题）。年/月一行、日 + 「今天」一行，
                 每行至多两个控件，选项文字能完整显示。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/spinYear"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1" />

                    <Spinner
                        android:id="@+id/spinMonth"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Spinner
                        android:id="@+id/spinDay"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1" />

                    <Button
                        android:id="@+id/btnToday"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/checkin_today"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <CheckBox
                android:id="@+id/switchForgot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/checkin_forgot"
                android:textColor="@color/fg"
                android:textSize="13sp" />

            <!-- 备注 -->
            <TextView
                style="@style/TextFormLabel"
                android:layout_marginTop="16dp"
                android:text="@string/checkin_note" />

            <EditText
                android:id="@+id/inputNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:gravity="top"
                android:hint="@string/checkin_note_hint"
                android:inputType="textMultiLine"
                android:maxLength="233"
                android:minLines="3"
                android:padding="12dp"
                android:textColor="@color/fg"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textCounter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="@string/checkin_save" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
