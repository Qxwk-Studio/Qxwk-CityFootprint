<?xml version="1.0" encoding="utf-8"?>
<!-- 排行一行（等价网页 .rank-item）：名次圆 + 城市(+省份) + 去过 N 人 + N 次，单行。
     行上方那条 1px 线就是网页的 border-bottom（表头已被去掉，第一行上方的线也保留）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/divider_top_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/textRank"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_rank_circle"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textColor="@color/muted_fg"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textCity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/fg"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textProvince"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/muted_fg"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/textPeople"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/muted_fg"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/textCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="monospace"
        android:textColor="@color/accent"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
