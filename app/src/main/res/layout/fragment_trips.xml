<?xml version="1.0" encoding="utf-8"?>
<!-- 行程页（2.0）：分段控件「打卡 (N) / 足迹 (N)」+ 分页列表。
     搜索框钉在标签下方（不再跟着列表滚走）——两页共用同一个关键字，放在页面里就得复制两份输入框。
     两段各自的条数直接写在标题里（随数据变），行内容在 TripsFragment 里按需拼。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- 分段栏：胶囊轨道 + 滑块，与主页/成就页同一套 -->
    <FrameLayout
        android:id="@+id/segTrack"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_segmented_track"
        android:padding="3dp">

        <View
            android:id="@+id/chipIndicator"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_segmented_pill" />

        <LinearLayout
            android:id="@+id/chipContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSegCheckins"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnSegTrips"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>


    <!-- 页面（滚动容器 + 卡片列）在 TripsFragment 里按分段创建，相邻页常驻 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
