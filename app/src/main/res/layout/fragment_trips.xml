<?xml version="1.0" encoding="utf-8"?>
<!-- 行程页（2.0）：分段控件「打卡 (N) / 足迹 (N)」+ 列表。
     两段各自的条数直接写在标题里（随数据变），行内容在 TripsFragment 里按需拼 ——
     目前只有两种行（行程 / 打卡），用 LinearLayout 手铺比给 RecyclerView 配两套 Adapter 省事。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- 分段栏：胶囊轨道 + 滑块，与主页/成就页同一套 -->
    <FrameLayout
        android:id="@+id/segTrack"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_segmented_track"
        android:padding="3dp">

        <View
            android:id="@+id/chipIndicator"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_segmented_pill" />

        <LinearLayout
            android:id="@+id/chipContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSegCheckins"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnSegTrips"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/listContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/textEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:text="@string/trips_empty"
                android:textColor="@color/text_tertiary"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
