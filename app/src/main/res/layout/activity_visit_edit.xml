<?xml version="1.0" encoding="utf-8"?>
<!-- 新增 / 编辑一条足迹。外壳与主页一致（顶栏 sidebar 底 + 内容），
     表单装进圆角描边卡片，私密开关单独一条带上方分隔线；保存按钮在卡片之外。
     顶栏左侧的返回按钮与主页右上角那颗动作按钮同一形态（36dp 圆角方块）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- ===== 顶栏（返回 + 标题）=====
         布局本体在 view_top_bar.xml（全 app 共用一份），返回按钮由 VisitEditActivity 置为可见。 -->
    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- id=content 是给 edge-to-edge 用的：导航栏那截高度加到它的 paddingBottom 上，
         表单滚到底时不会被手势条盖住（见 ui/EdgeToEdge.kt） -->
    <ScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- 城市是「点开选择」而不是手输：坐标与 adcode 必须来自城市表，
                         手输城市名会让地图上找不到点（lat/lng 填什么都是编的）。
                         右侧那颗准心是「定位到最近的城市」（网页 docs/index.html 添加弹窗里同款按钮）：
                         用 TextInputLayout 的 endIcon 而不是另起一个按钮，省得为一个图标再拆一层布局 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/cityLayout"
                        style="@style/Widget.App.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/edit_city"
                        app:endIconContentDescription="@string/edit_locate"
                        app:endIconDrawable="@drawable/ic_locate"
                        app:endIconMode="custom"
                        app:endIconTint="@color/accent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputCity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:hint="@string/edit_city_hint"
                            android:inputType="none"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- 到访时间：两个下拉（年 / 月），对齐网页 docs/visits.html 编辑弹窗的
                         visitYear + visitMonth 与「记不清了」开关。
                         之前是点开一个对话框选，现在摆在台面上，少一次点击、也少一层遮挡。

                         下拉用 AutoCompleteTextView（inputType=none 只让选不让敲）而不是 Spinner：
                         Spinner 的弹层是系统对话框样式，与全 app 的 M3 弹层不是一套。
                         年份是「年」下拉的首项、月份是「月」下拉的首项，两张菜单都认空选 ——
                         后端只认 YYYY 与 YYYY-MM 两种形态（worker.js），所以「没选年份」= 没有日期，
                         「选了年份没选月份」= 只有年份。 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/edit_date"
                        android:textColor="@color/fg"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/yearLayout"
                            style="@style/Widget.App.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/edit_date_year"
                            app:endIconMode="dropdown_menu">

                            <AutoCompleteTextView
                                android:id="@+id/inputYear"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/monthLayout"
                            style="@style/Widget.App.TextInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:hint="@string/edit_date_month"
                            app:endIconMode="dropdown_menu">

                            <AutoCompleteTextView
                                android:id="@+id/inputMonth"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="none" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- 「记不清了」开关：与网页的 forgotDate 同义 —— 勾上 = 这条足迹没有日期
                         （后端允许 visit_date 为空），两个下拉随之清空并置灰 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/edit_date_forgot"
                            android:textColor="@color/muted_fg"
                            android:textSize="13sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchForgot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/edit_date_forgot" />
                    </LinearLayout>

                    <!-- 出行方式：可多选、也可一个都不选（老数据本来就没这个概念）。
                         9 个 chip 由 VisitEditActivity 按 logic/Transport.kt 的顺序铺进来，
                         不在这里写死选项 —— 选项集合必须与后端 TRANSPORTS、网页端同源，
                         在布局里再抄一份迟早会漂。也没有用 TextInputLayout 包住：
                         那套是给单行文本框的浮动标签，套 ChipGroup 只会多一层没意义的壳。 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/edit_transport"
                        android:textColor="@color/fg"
                        android:textSize="14sp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/groupTransport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:chipSpacingHorizontal="6dp"
                        app:chipSpacingVertical="6dp"
                        app:singleLine="false"
                        app:singleSelection="false" />

                    <!-- maxLength=100 与后端 slice(0,100) 同一口径：超过就不让再打，
                         而不是打完再被截断（被静默截断的输入最让人恼火）。
                         字数提示用单独的 TextView（见下面 noteCounter），不去用 TextInputLayout 的
                         内建 counter —— 内建 counter 在自定义字号下表现不一致 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/noteLayout"
                        style="@style/Widget.App.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/edit_note">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:inputType="textMultiLine"
                            android:maxLength="100"
                            android:minLines="3" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/textNoteCounter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:textColor="@color/muted_fg"
                        android:textSize="11sp" />

                    <!-- 私密开关：左侧两行文案（标题 + 说明），右侧开关本体 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="@color/border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/edit_private"
                                android:textColor="@color/fg"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/edit_private_hint"
                                android:textColor="@color/muted_fg"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchPrivate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@string/edit_private" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 底部按钮区：对齐网页编辑弹窗的 .dialog-actions —— 「取消 + 保存」并排、各占一半。
                 取消走 Ghost（描边 + 次要文字色 + 胶囊），保存是主色胶囊；保存上不再挂 ✓ 图标：
                 网页那两颗都是纯文字，加了图标的保存与旁边的删除看着就不像一套（这也正是它俩
                 「文案不统一」的观感来源）。
                 取消与顶栏返回都是「不保存退出」，留两颗不冲突：返回是系统习惯，取消是网页习惯 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancel"
                    style="@style/Widget.App.Button.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/common_cancel"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    style="@style/Widget.App.Button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/edit_save"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 删除只在编辑态出现（新增时 hide 掉）：还没有的记录谈不上删除。
                 不再整宽 —— 网页编辑弹窗里没有这颗（删除在列表行），这里是低频的危险动作，
                 收成一颗靠左的小按钮，免得和上面那对主次按钮抢视线 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.App.Button.Danger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minWidth="0dp"
                android:text="@string/edit_delete"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/editProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textEditError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/destructive"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                style="@style/BodyMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/edit_footnote" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
