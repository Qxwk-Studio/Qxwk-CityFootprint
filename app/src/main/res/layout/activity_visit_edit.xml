<?xml version="1.0" encoding="utf-8"?>
<!-- 新增 / 编辑一条足迹。外壳与主页一致（顶栏 sidebar 底 + 内容 + 页脚），
     表单装进圆角描边卡片，私密开关单独一条带上方分隔线；保存按钮在卡片之外。
     顶栏左侧的返回按钮与主页右上角那颗动作按钮同一形态（36dp 圆角方块）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- ===== 顶栏（返回 + 标题） ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sidebar"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_action_button"
                android:contentDescription="@string/common_back"
                android:padding="6dp"
                android:src="@drawable/ic_back"
                android:tint="@color/sidebar_fg" />

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/sidebar_fg"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/sidebar_border" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- 城市是「点开选择」而不是手输：坐标与 adcode 必须来自城市表，
                         手输城市名会让地图上找不到点（lat/lng 填什么都是编的） -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/cityLayout"
                        style="@style/Widget.App.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/edit_city">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputCity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:cursorVisible="false"
                            android:focusable="false"
                            android:hint="@string/edit_city_hint"
                            android:inputType="none"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- inputType 必须是 text 而不是 number/numberDecimal：
                         日期允许「2024」与「2024-08」两种写法，数字键盘上没有减号，用户根本打不出年月 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/dateLayout"
                        style="@style/Widget.App.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/edit_date"
                        app:helperText="@string/edit_date_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputDate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- maxLength=100 与后端 slice(0,100) 同一口径：超过就不让再打，
                         而不是打完再被截断（被静默截断的输入最让人恼火）。
                         字数提示用单独的 TextView（见下面 noteCounter），不去用 TextInputLayout 的
                         内建 counter —— 内建 counter 在自定义字号下表现不一致 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/noteLayout"
                        style="@style/Widget.App.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/edit_note">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:inputType="textMultiLine"
                            android:maxLength="100"
                            android:minLines="3" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/textNoteCounter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:textColor="@color/muted_fg"
                        android:textSize="11sp" />

                    <!-- 私密开关：左侧两行文案（标题 + 说明），右侧开关本体 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="@color/border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/edit_private"
                                android:textColor="@color/fg"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/edit_private_hint"
                                android:textColor="@color/muted_fg"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchPrivate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@string/edit_private" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.App.Button"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/edit_save"
                android:textSize="14sp"
                app:icon="@drawable/ic_check"
                app:iconGravity="textEnd"
                app:iconPadding="6dp"
                app:iconSize="16dp"
                app:iconTint="@color/on_accent" />

            <!-- 删除只在编辑态出现（新增时 hide 掉）：还没有的记录谈不上删除 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.App.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/edit_delete"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/editProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textEditError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/destructive"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                style="@style/BodyMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/edit_footnote" />
        </LinearLayout>
    </ScrollView>

    <!-- ===== 页脚 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/footer_brand"
                android:textColor="@color/muted_fg"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/footerVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/muted_fg"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
