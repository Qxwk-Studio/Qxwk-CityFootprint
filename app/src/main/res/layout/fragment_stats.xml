<?xml version="1.0" encoding="utf-8"?>
<!-- 全站统计页（版面照网页端 docs/stats.html）：四张数字卡（2×2）→ 城市次数排名 → 成就达成人数。
     数字卡对齐网页 .stat-card：标签在上、主色大数字在下；网页在窄屏就是两列，手机照排。

     整页用 NestedScrollView 而不是把排行/成就各做成 RecyclerView：块少、条数也不多
     （城市几百、成就 42），一次铺开最省事。

     外壳套 SwipeRefreshLayout：数据页（主页 / 成就 / 统计）统一走下拉刷新，
     原先那个居中 ProgressBar 已去掉 —— 加载态改由下拉指示器表达（见 StatsFragment.load）。 -->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipe"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/destructive"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- 管理员视图提示（等价网页 .admin-view-note 的琥珀横幅）。
                 只有管理员看得到，隐藏时不留空。 -->
            <TextView
                android:id="@+id/textAdminNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_admin_note"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp"
                android:text="@string/stats_admin_note"
                android:textColor="@color/admin_note_fg"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- ===== 四张数字卡：总行程 / 总城市 / 覆盖省份 / 总用户（2×2） ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/stats_total_visits"
                            android:textColor="@color/muted_fg"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/valueVisits"
                            style="@style/StatValue.Primary"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="6dp"
                            android:text="-" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/stats_total_cities"
                            android:textColor="@color/muted_fg"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/valueCities"
                            style="@style/StatValue.Primary"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="6dp"
                            android:text="-" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/stats_total_provinces"
                            android:textColor="@color/muted_fg"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/valueProvinces"
                            style="@style/StatValue.Primary"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="6dp"
                            android:text="-" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/stats_total_users"
                            android:textColor="@color/muted_fg"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/valueUsers"
                            style="@style/StatValue.Primary"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="6dp"
                            android:text="-" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ===== 城市次数排名 ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/CardTitle"
                        android:text="@string/stats_rank_title" />

                    <!-- 行由代码 inflate（item_rank.xml）后 add 进来 -->
                    <LinearLayout
                        android:id="@+id/rankContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <!-- 排行空态（等价网页 .empty）：全站还没人记过足迹时顶掉列表与展开按钮 -->
                    <TextView
                        android:id="@+id/textRankEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingTop="18dp"
                        android:paddingBottom="18dp"
                        android:text="@string/stats_rank_empty"
                        android:textColor="@color/muted_fg"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <!-- 展开/收起：默认前 10 名，展开到前 50 名（对齐网页 .rank-toggle） -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRankMore"
                        style="@style/Widget.App.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="14dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:textColor="@color/accent"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== 成就达成人数 ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/CardTitle"
                        android:text="@string/stats_achv_count_title" />

                    <!-- 分类标题与条目由代码 inflate 后 add 进来 -->
                    <LinearLayout
                        android:id="@+id/achCountContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>