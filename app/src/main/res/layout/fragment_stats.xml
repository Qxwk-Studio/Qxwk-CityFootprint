<?xml version="1.0" encoding="utf-8"?>
<!-- 整页用 NestedScrollView 而不是把排行/成就各做成 RecyclerView：
     一屏里只有两块列表、条数也不多（城市几百、成就 42），嵌进滚动页里最省事；
     真做成多类型 RecyclerView 是给「列表长到几千条」准备的，这里用不上。 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/textError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#B3261E"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 四块数字：两行两列。写成固定的两行而不是 GridLayout ——
             行列关系一眼看得见，比数标签属性快 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNumbers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/valueVisits"
                            style="@style/StatValue"
                            android:text="-" />

                        <TextView
                            style="@style/StatLabel"
                            android:text="@string/stats_total_visits" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/valueCities"
                            style="@style/StatValue"
                            android:text="-" />

                        <TextView
                            style="@style/StatLabel"
                            android:text="@string/stats_total_cities" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/valueUsers"
                            style="@style/StatValue"
                            android:text="-" />

                        <TextView
                            style="@style/StatLabel"
                            android:text="@string/stats_total_users" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/valueMyCities"
                            style="@style/StatValue"
                            android:text="-" />

                        <TextView
                            style="@style/StatLabel"
                            android:text="@string/stats_my_cities" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 管理员看到的数字含私密足迹（后端按 isAdmin 过滤），这一条要说明白，
                     否则会以为统计把别人的私密记录也抖出来了 -->
                <TextView
                    android:id="@+id/textAdminNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/stats_admin_note"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/stats_rank_title" />

                <!-- 行由代码 inflate（item_rank.xml）后 add 进来 -->
                <LinearLayout
                    android:id="@+id/rankContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/CardTitle"
                    android:text="@string/stats_achievements_title" />

                <TextView
                    android:id="@+id/textAchievementProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/achievementsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>