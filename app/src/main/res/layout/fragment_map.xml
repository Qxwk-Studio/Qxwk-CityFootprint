<?xml version="1.0" encoding="utf-8"?>
<!-- 地图页：地图本体是 osmdroid 的真实地图（高德免 Key 瓦片，见 MapFragment），
     上面叠三层浮层 —— 图例（左上，按用户筛选）、进度/空态、城市明细卡（底部）。
     浮层一律用设计稿那套浅色圆角小卡片（白底 + 灰描边，@drawable/bg_card）：
     底图是深浅不一的瓦片，白卡片比半透明黑条更贴合整体浅色风格。

     图例与明细卡的内容都是运行时按数据生成的（用户列表 / 行程条数都不固定），
     所以这里只给容器，行由 MapFragment 用代码加。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- osmdroid 的 MapView：**按类名写死的自定义 View**，
         R8 那侧的名字契约见 proguard-rules.pro（改名 = 打开地图页直接崩）。
         瓦片源、缩放、多指手势都在代码里设（见 MapFragment），布局里不写自定义属性：
         属性名一旦拼错不会报错，只会静默不生效 -->
    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/textEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/map_empty"
        android:textColor="@color/text_tertiary"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- 右上角浮层组：管理员提示在上、定位按钮在下。两块都得待在右上角（网页端管理员提示就在右上角），
         只能竖着排 —— 横着排不开。管理员提示 GONE 时这组自动收成一颗按钮，不留空位。
         定位按钮是 App 侧新增的入口：网页那颗「我的位置」蓝点由添加弹窗触发，
         App 把添加/编辑与地图分成了两页，地图页得自己给个入口（见 MapFragment.locate） -->
    <LinearLayout
        android:id="@+id/topActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:gravity="end"
        android:orientation="vertical">

        <!-- 管理员视图提示（对齐网页 docs/index.html 的 .adminViewNote）：
             文案与显隐由 MapFragment.load 按后端 isAdmin 给，非管理员时 GONE 不留空。
             复用统计页那条横幅的底图/文字色（bg_admin_note + admin_note_fg），两端是同一套管理员视觉语言 -->
        <TextView
            android:id="@+id/textAdminNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_admin_note"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="@string/map_admin_note"
            android:textColor="@color/admin_note_fg"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 定位到我的位置。底图复用顶栏那颗动作按钮（36dp 正圆 + 描边，见 bg_action_button）——
             地图是深浅不一的瓦片，透明底的图标按钮会看不清。尺寸必须跟着这个底图走（18dp 圆角 = 半高） -->
        <ImageButton
            android:id="@+id/btnLocate"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_action_button"
            android:contentDescription="@string/map_locate"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_locate"
            android:tint="@color/accent" />
    </LinearLayout>

    <!-- 图例（左上角）：标题行整行可点，用来收起/展开下面的用户列表。
         clickable="true" 是为了**吃掉落在卡片上的手势**：否则在卡片留白处拖动会穿透到下面的地图去平移 -->
    <LinearLayout
        android:id="@+id/legend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/legendHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/map_legend_title"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/legendToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/map_legend_toggle_collapsed"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 用户多了就滚动：maxHeight 收住高度，免得图例把地图盖满。
             默认 GONE = 收起（与网页 docs/index.html 的默认一致）：进地图页先只看地图本身，
             要筛人时点标题行展开。箭头初值也要跟着用 collapsed（▸），否则首帧指向反了 -->
        <ScrollView
            android:id="@+id/legendScroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxHeight="260dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/legendList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="120dp"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- 城市明细卡（底部）：点地图上的城市才出现，内容由 MapFragment.showCity 填。
         clickable 同图例：吃掉卡片上的手势，别让拖动穿透到地图去平移。

         整宽铺满、贴底；高度要压住 —— 一行一条行程，行数一多卡片就爬上半个屏幕，
         所以上下内边距收薄，列表另设 maxHeight（装不下就在卡片内滚，不再长高） -->
    <LinearLayout
        android:id="@+id/cityCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cityCardTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/fg"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 关掉明细卡：触屏没有 hover，也没有「点地图空白处」的钩子，给一颗明确的关闭键 -->
            <TextView
                android:id="@+id/cityCardClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/map_city_close"
                android:padding="6dp"
                android:text="@string/map_city_close_glyph"
                android:textColor="@color/muted_fg"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- 加载中 / 加载失败 / 没有符合条件的行程 都复用这一行（网页这三句都走 .popup-more，用 tertiary） -->
        <TextView
            android:id="@+id/cityCardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 装不下就卡片内部滚：想再矮/再高就调这个 maxHeight（列表占卡片高度的大头） -->
        <ScrollView
            android:id="@+id/cityCardScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxHeight="120dp">

            <LinearLayout
                android:id="@+id/cityCardList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>