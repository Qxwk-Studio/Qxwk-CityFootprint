<?xml version="1.0" encoding="utf-8"?>
<!-- 地图页：地图本体是 osmdroid 的真实地图（高德免 Key 瓦片，见 MapFragment），
     上面叠三层浮层 —— 图例（左上，按用户筛选）、进度/空态、城市明细卡（底部）。
     浮层一律用设计稿那套浅色圆角小卡片（白底 + 灰描边，@drawable/bg_card）：
     底图是深浅不一的瓦片，白卡片比半透明黑条更贴合整体浅色风格。

     图例与明细卡的内容都是运行时按数据生成的（用户列表 / 行程条数都不固定），
     所以这里只给容器，行由 MapFragment 用代码加。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- osmdroid 的 MapView：**按类名写死的自定义 View**，
         R8 那侧的名字契约见 proguard-rules.pro（改名 = 打开地图页直接崩）。
         瓦片源、缩放、多指手势都在代码里设（见 MapFragment），布局里不写自定义属性：
         属性名一旦拼错不会报错，只会静默不生效 -->
    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/textEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/map_empty"
        android:textColor="@color/text_tertiary"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- 图例（左上角）：标题行整行可点，用来收起/展开下面的用户列表。
         clickable="true" 是为了**吃掉落在卡片上的手势**：否则在卡片留白处拖动会穿透到下面的地图去平移 -->
    <LinearLayout
        android:id="@+id/legend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/legendHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/map_legend_title"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/legendToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/map_legend_toggle_collapsed"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 用户多了就滚动：maxHeight 收住高度，免得图例把地图盖满。
             默认 GONE = 收起（与网页 docs/index.html 的默认一致）：进地图页先只看地图本身，
             要筛人时点标题行展开。箭头初值也要跟着用 collapsed（▸），否则首帧指向反了 -->
        <ScrollView
            android:id="@+id/legendScroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxHeight="260dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/legendList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="120dp"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- 城市明细卡（底部）：点地图上的城市才出现，内容由 MapFragment.showCity 填。
         clickable 同图例：吃掉卡片上的手势，别让拖动穿透到地图去平移 -->
    <LinearLayout
        android:id="@+id/cityCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cityCardTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/fg"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 关掉明细卡：触屏没有 hover，也没有「点地图空白处」的钩子，给一颗明确的关闭键 -->
            <TextView
                android:id="@+id/cityCardClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/map_city_close"
                android:padding="6dp"
                android:text="@string/map_city_close_glyph"
                android:textColor="@color/muted_fg"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- 加载中 / 加载失败 / 没有符合条件的行程 都复用这一行（网页这三句都走 .popup-more，用 tertiary） -->
        <TextView
            android:id="@+id/cityCardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/cityCardScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxHeight="240dp">

            <LinearLayout
                android:id="@+id/cityCardList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>