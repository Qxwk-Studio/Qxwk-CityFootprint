<?xml version="1.0" encoding="utf-8"?>
<!-- 成就页（2.0）：四分类滑动胶囊（占满整宽）+ 每个分类一页的成就卡列表。
     解锁进度卡是列表的第一项，跟着列表一起滚，不再钉在顶部；每页各自保留滚动位置。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/segTrack"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_segmented_track"
        android:padding="3dp">

        <View
            android:id="@+id/chipIndicator"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_segmented_pill" />

        <LinearLayout
            android:id="@+id/chipContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal" />
    </FrameLayout>

    <!-- 页面（每个分类一个 RecyclerView）在 AchievementsFragment 里创建，相邻页常驻 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
