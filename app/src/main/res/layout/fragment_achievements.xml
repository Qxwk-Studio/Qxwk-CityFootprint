<?xml version="1.0" encoding="utf-8"?>
<!-- 「我的成就」独立页：内容即原统计页底部那张成就卡，按 tab 拆出来单独成页。
     判定用的是「我自己的足迹」，所以这一页只发 GET /api/my-visits 一个请求。
     用 NestedScrollView 而不是 RecyclerView：成就总共约 42 条，一次铺开最省事。

     样式按设计稿重做：卡片标题行右侧放「已点亮 / 总数」比值，下面一条圆角进度条，
     再往下是分组列表（未达成的整组压灰，见 item_achievement）。 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/textError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/destructive"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CardTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/stats_achievements_title" />

                    <TextView
                        android:id="@+id/textProgressRatio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/fg"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 总进度可视化：与网页端成就卡顶部的进度条对齐（轨道用 muted，填充用主色） -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/achievementBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    app:indicatorColor="@color/accent"
                    app:trackColor="@color/muted"
                    app:trackCornerRadius="3dp"
                    app:trackThickness="6dp" />

                <!-- 分组与条目由代码 inflate（item_achievement_group.xml / item_achievement.xml）后 add 进来 -->
                <LinearLayout
                    android:id="@+id/achievementsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
