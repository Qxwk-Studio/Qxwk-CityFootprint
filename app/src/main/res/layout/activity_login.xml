<?xml version="1.0" encoding="utf-8"?>
<!-- 登录页（通行证）。与主页用同一套外壳：顶栏 + 内容 + 底栏。
     顶栏与底栏都来自公共样式（Widget.App.ShellBand，即 sidebar 底色那条横带）；
     顶栏本体在 view_top_bar.xml（无返回按钮，标题在代码里填）。
     内容沿用现有（大标题 / 副标题 / 账号密码 / 登录 / 错误提示），
     账号说明脚注从滚动区里挪到固定底栏 —— 与主壳「底栏也是 sidebar 一条」的形态对齐。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- ===== 顶栏（登录页只有标题，没有返回按钮） ===== -->
    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- id=content 是给 edge-to-edge 用的：导航栏那截高度加到它的 paddingBottom 上
         （见 ui/EdgeToEdge.kt）。这一页底栏固定在下面，所以不加也没关系，
         但留着一个 id 是为了四个 Activity 的调用形状一致。 -->
    <ScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/login_title"
                    android:textColor="@color/fg"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/login_subtitle"
                    android:textColor="@color/muted_fg"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/loginCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- hint 写在 TextInputLayout 上、不写在 EditText 上：
                         写在内层的话，输入后提示会消失，而标题式提示会浮到框线上面一直留着 -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/accountLayout"
                        style="@style/Widget.App.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/login_account">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputAccount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/passwordLayout"
                        style="@style/Widget.App.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/login_password">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- 同意协议的勾选行：放在登录按钮**上方**（与网页 account.html 同一位置）。
                         勾选框只管勾选；「《用户协议》」那截在代码里做成可点链接（见 LoginActivity.bindAgreeRow），
                         所以这里不写 autoLink / 也不给整行套点击 -->
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkAgree"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:text="@string/login_agree_terms"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogin"
                        style="@style/Widget.App.Button"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="16dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/login_submit"
                        android:textSize="14sp"
                        app:icon="@drawable/ic_arrow_right"
                        app:iconGravity="textEnd"
                        app:iconPadding="6dp"
                        app:iconSize="16dp"
                        app:iconTint="@color/on_accent" />

                    <ProgressBar
                        android:id="@+id/loginProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:visibility="gone" />

                    <!-- 登录失败的原样文案（通行证的 error 字段）：401「帐号或密码不正确」、
                         429「失败次数过多…」、以及「该账号还没设置过密码」那条引导，都显示在这里 -->
                    <TextView
                        android:id="@+id/textLoginError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/destructive"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 引导去通行证：注册与找回密码都在通行证登录页里，App 内不做这两件事。
                 刻意放**卡片外**：卡片里是登录表单（按钮下面还有进度条与报错文案），
                 塞进去会让「登录失败」的提示排在引导行下面，看着像引导的注释。
                 整行可点（水波纹 + 主色文字），跳系统浏览器的逻辑在 LoginActivity。 -->
            <TextView
                android:id="@+id/textRegisterTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/login_register_tip"
                android:textColor="@color/accent"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <!-- ===== 底栏：账号说明 =====
         与主壳底栏同一形态（sidebar 底 + 朝上的 1dp 分隔线），只是内容从导航换成一行说明。
         id=bottomBar 给 edge-to-edge 用：手势条那截高度加到 paddingBottom 上（见 ui/EdgeToEdge.kt）。 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        style="@style/Widget.App.ShellBand">

        <View style="@style/Widget.App.ShellDivider" />

        <TextView
            style="@style/BodyMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="10dp"
            android:text="@string/profile_account_note" />
    </LinearLayout>
</LinearLayout>
