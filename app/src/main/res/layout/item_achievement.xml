<?xml version="1.0" encoding="utf-8"?>
<!-- 一条成就 = 一张独立小卡（网页 docs/visits.html 的 .achievement）：
     图标与名称占第一行，说明换到第二行、左边与名称对齐 —— 说明就装在名称同一个「正文列」里，
     两行的左边缘天然对齐（网页那边也是 name / desc 同在一个 .body 里）。勾在卡片右侧，
     与整块正文垂直居中。

     未达成 / 达成不靠两套布局区分，都由代码改这张卡本身（看 AchievementsFragment）：
       - 未达成：整卡 alpha 0.55（网页 .achievement 的 opacity）；
       - 达成：alpha 1 + 底色换 accent_light + 描边换 achievement_done_stroke，
         并让右侧那个勾出现（勾的样式是 bg_check_circle 的实心主色圆 + 白 ✓，网页同款）。

     圆角就是全 app 的默认卡片样式（Widget.App.CardView = 14dp），与网页 .achievement 的
     radius-md 同档 —— 行程卡 item_visit.xml 也走同一档，全 app 的卡片不再各写各的。

     卡片下边距 8dp 与 item_achievement_group 的组下边距 16dp 相加，正好等于网页的组间 24px。 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <!-- 图标是 emoji（彩色字体）：不给它 setTextColor，压不灰反而会出奇怪的颜色（见 AchievementsFragment） -->
        <TextView
            android:id="@+id/textIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp" />

        <!-- 正文列：名称一行、说明另起一行。
             0dp + weight=1 等价网页的 flex:1 1 0 + min-width:0：把剩余宽度吃满，
             说明再长也只在本列里折行，不会把右侧的勾挤出屏幕 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/fg"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/muted_fg"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 已达成才出现的勾：主色圆底 + 白勾（网页 .achievement .check）。
             未达成时 GONE，不占视觉重心。 -->
        <TextView
            android:id="@+id/textCheck"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_check_circle"
            android:gravity="center"
            android:text="@string/achievement_check"
            android:textColor="@color/on_accent"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>