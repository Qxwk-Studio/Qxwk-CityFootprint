<?xml version="1.0" encoding="utf-8"?>
<!-- 主页页头（「📊 足迹统计」五张小卡 + 「📍 行程记录」标题与新增按钮），
     由 ui/VisitsHeaderAdapter 铺成列表的第 0 项 —— 主页要整页一起滚，
     页头就必须交给同一个 RecyclerView 管，而不是钉在列表上方各滚各的。

     横向 16dp 留白来自 RecyclerView 自己的 paddingStart/End（见 fragment_visits.xml），
     所以这里每个子 View 都按 match_parent 排，不再各自写 layout_marginStart/End=16dp。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="vertical">

    <!-- ===== 足迹统计：标题 + 五张小卡（对齐网页 .section-title + .visit-stats） ===== -->
    <TextView
        style="@style/CardTitle"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:text="@string/visits_overview_title" />

    <!-- 第一行整行：时间跨度（日期串比数字长，独占一行免得两个卡不对齐） -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/StatCardLabel"
                android:text="@string/visits_overview_range" />

            <!-- 日期区间（形如 2019 → 2026-05）不是纯数字：字号比数字卡收一档（网页 .value.date-range） -->
            <TextView
                android:id="@+id/valueRange"
                style="@style/StatValue.Primary"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="—"
                android:textSize="18sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 第二行：去过城市 / 足迹 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/StatCardLabel"
                    android:text="@string/visits_overview_cities" />

                <TextView
                    android:id="@+id/valueCities"
                    style="@style/StatValue.Primary"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:text="0" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/StatCardLabel"
                    android:text="@string/visits_overview_visits" />

                <TextView
                    android:id="@+id/valueVisits"
                    style="@style/StatValue.Primary"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:text="0" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- 第三行：省份 / 最常用出行。
         两张卡必须一样高：「最常用出行」的值是文字、字号比数字小一档（见下面 textSize 18sp），
         而横向 LinearLayout 默认是各量各的高度，于是这一张会比旁边矮一截。
         卡上写 layout_height="match_parent" 让它撑满行高（行高由较高的那张决定）——
         网页那边是 grid 的隐式 stretch，效果同一个。
         第二行两张卡都是 24sp 数字，本来等高，就不必再写。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/StatCardLabel"
                    android:text="@string/visits_overview_provinces" />

                <TextView
                    android:id="@+id/valueProvinces"
                    style="@style/StatValue.Primary"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:text="0" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/StatCardLabel"
                    android:text="@string/visits_overview_transport" />

                <!-- 值是文字（火车 / 自驾）而不是数字：字号收到与「时间跨度」同档，免得撑满卡宽 -->
                <TextView
                    android:id="@+id/valueTransport"
                    style="@style/StatValue.Primary"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="—"
                    android:textSize="18sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- ===== 「行程记录」标题行（左侧标题，右侧主色「添加足迹」） ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/CardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/visits_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            style="@style/Widget.App.Button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/visits_add"
            android:textSize="13sp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="16dp" />
    </LinearLayout>
</LinearLayout>