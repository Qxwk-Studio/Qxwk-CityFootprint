<?xml version="1.0" encoding="utf-8"?>
<!-- 地图页（2.0）：MapLibre 底图 + 点亮去过的城市 + 点击城市弹只读面板。
     底图与城市面都在 MapFragment 里配（style 是运行时拼的），这里只有容器与两块浮层。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 载入中/失败提示：底图在真机上要几百毫秒才出来，不提示就是一片空白 -->
    <TextView
        android:id="@+id/textStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/map_loading"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- 版权署名（MapLibre / OpenStreetMap / Protomaps）统一放在「我的 → 开源项目与许可」，
         地图上不再压两块小字；MapLibre 自带的 (i) 按钮也在 MapFragment 里关掉了。 -->

    <!-- 定位按钮：卡片底 + 主题色图标。原来图标是 on_accent（白色），压在白色卡片底上，
         浅色模式里等于看不见 —— 改成 accent 色，深浅两套都清晰。 -->
    <ImageButton
        android:id="@+id/btnLocate"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_action_button"
        android:contentDescription="@string/map_locate"
        android:padding="10dp"
        android:src="@drawable/ic_locate"
        android:tint="?attr/appAccent" />

    <!-- 点击城市后的只读面板：城市名 + 打卡条数 + 关闭，列表在代码里铺 -->
    <LinearLayout
        android:id="@+id/cityCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="8dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_city"
                app:tint="?attr/appAccent" />

            <TextView
                android:id="@+id/textCity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:textColor="@color/fg"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/map_close"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                android:tint="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/textCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/cityList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
