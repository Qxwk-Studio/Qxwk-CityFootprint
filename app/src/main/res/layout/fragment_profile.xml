<?xml version="1.0" encoding="utf-8"?>
<!-- 「我的」：手机设置页那种**分组列表**（不再是网页 account.html 的一叠描边卡片）。
     自上而下：居中身份区（头像 / 昵称 / 管理员徽章 / UID）→
     「账号」组（专属地图颜色、通行证中心）→「设置」组（外观、清除缓存）→
     「关于软件」组（开源内容 / 开发者 / 当前版本 / 检查更新 / 公告）→ 单独一条居中的红色「退出登录」。

     分组形态的约定（样式都在 themes.xml 的 SettingsGroup* 那一节）：
     组名是组**上方**一行 12sp 灰字，分组本身是无描边白底圆角块，
     组内行之间一条 1dp 分隔线，可点行尾收一枚 18dp 箭头（ic_arrow_right）。

     整页套 NestedScrollView：组多了以后比一屏高，不套的话最后一组在小屏上会被裁掉。
     页面底色用主题的 colorBackground（@color/bg 浅灰）—— 「白分组浮在浅灰上」正是这一版要的层次，
     所以**没有一个卡片带描边**（对比 drawable/bg_settings_group.xml 与 bg_card.xml 的注释）。 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- ===== 身份区：直接铺在页面底色上，不套卡片 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <!-- 头像：真实头像（通行证给的图）与「昵称首字」两版叠在一起，
                 同一时刻只显示一个 —— 图还没下来 / 没有 / 加载失败时显示首字那版（见 ProfileFragment.showAvatar）。
                 首字版的底色在代码里按通行证主题色画（ProfileFragment.circleDrawable），布局不写死。 -->
            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp">

                <TextView
                    android:id="@+id/textAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="#FFFFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <!-- 真实头像。用 M3 的 ShapeableImageView 裁成正圆（形状见 themes.xml 的 AvatarCircle），
                     而不是引图片加载库 —— 一张几十 KB 的图，HttpURLConnection + BitmapFactory 就够（见 ProfileFragment） -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imageAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/profile_avatar"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/AvatarCircle" />
            </FrameLayout>

            <!-- 昵称、徽章、UID 都居中（match_parent + gravity=center：长昵称也不会把这一块顶宽）。
                 徽章放昵称下面单独一行，而不是跟在昵称右边 —— 居中布局里挤在一行时，
                 长昵称 + 徽章会把两个都挤变形，GONE 掉时还会留下一个偏移 -->
            <TextView
                android:id="@+id/textNickname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/fg"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- 管理员徽章（对应网页 account.html 的 #adminBadge）：非管理员时 GONE 不留空位。
                 复用统计页那条横幅的底图/文字色（bg_admin_note + admin_note_fg），两端是同一套管理员视觉语言 -->
            <TextView
                android:id="@+id/textAdminBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_admin_note"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="@string/profile_admin_badge"
                android:textColor="@color/admin_note_fg"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- UID：与网页 .user-uid 同一档（0.78rem 等宽、最弱的 tertiary 色） -->
            <TextView
                android:id="@+id/textUid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:fontFamily="monospace"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textAccountNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/profile_account_note"
                android:textColor="@color/muted_fg"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ===== 账号 ===== -->
        <TextView
            style="@style/SettingsGroupTitle"
            android:text="@string/profile_group_account" />

        <LinearLayout
            style="@style/SettingsGroup"
            android:clipToOutline="true">

            <!-- 专属地图颜色：只读行，行尾是那枚 22dp 色点（代码里按通行证主题色画，见 ProfileFragment.colorDot） -->
            <LinearLayout style="@style/SettingsRow">

                <LinearLayout style="@style/SettingsRowCopy">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:text="@string/profile_color_label" />
                </LinearLayout>

                <View
                    android:id="@+id/colorDot"
                    android:layout_width="22dp"
                    android:layout_height="22dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:background="@color/border" />

            <!-- 通行证中心：改昵称 / 颜色 / 密码、生成邀请码只在通行证那边有，
                 点了跳系统浏览器打开（没有按钮，整行可点） -->
            <LinearLayout
                android:id="@+id/rowPassport"
                style="@style/SettingsRow"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout style="@style/SettingsRowCopy">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:text="@string/profile_passport_title" />

                    <TextView
                        style="@style/SettingsRowSub"
                        android:text="@string/profile_passport_hint" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@color/text_tertiary" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 设置 =====
             组名换成灰字、内容换成行之后，这一组就是上一版那张「⚙️ 设置」卡的落点。
             位置排在「账号」后面（用户指定的顺序：账号 → 设置 → 关于） -->

        <TextView
            style="@style/SettingsGroupTitle"
            android:text="@string/profile_group_settings" />

        <LinearLayout
            style="@style/SettingsGroup"
            android:clipToOutline="true">

            <!-- 外观（浅色 / 深色 / 跟随系统）：整行可点 → 弹三选（见 ProfileFragment.chooseAppearance），
                 选完立刻生效并重建当前页。
                 行尾是「当前值 + 箭头」两颗：值让用户不点也知道现在是什么（网页那颗太阳/月亮按钮的图标
                 只表示「点一下会变成另一个」，看不出当前态），箭头表示这行还能点。
                 弹窗里选完的落点是本机偏好，与账号无关（退出登录不清，见 data/Store 的 appearance） -->
            <LinearLayout
                android:id="@+id/rowAppearance"
                style="@style/SettingsRow"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout style="@style/SettingsRowCopy">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:text="@string/profile_appearance_title" />
                </LinearLayout>

                <!-- 当前值在 refresh() 里填（跟随系统 / 浅色 / 深色），布局不写死 -->
                <TextView
                    android:id="@+id/textAppearanceValue"
                    style="@style/SettingsRowValue"
                    android:layout_marginEnd="6dp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@color/text_tertiary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:background="@color/border" />

            <!-- 清除缓存：整行可点，点了直接清（没有二级页，也没有按钮） -->
            <LinearLayout
                android:id="@+id/rowClearCache"
                style="@style/SettingsRow"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout style="@style/SettingsRowCopy">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:text="@string/profile_clear_cache_title" />

                    <TextView
                        style="@style/SettingsRowSub"
                        android:text="@string/profile_clear_cache_hint" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@color/text_tertiary" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 关于软件 =====
             三行只读：标题在左，内容做副标题（开源那三行本身就是三条独立字符串，逐行一个 TextView 排下来），
             版本是行尾的值。条目仍是纯文本、不做超链接（理由见下面 @+id/textAboutVersion 那段注释） -->
        <TextView
            style="@style/SettingsGroupTitle"
            android:text="@string/profile_group_about" />

        <LinearLayout
            style="@style/SettingsGroup"
            android:clipToOutline="true">

            <LinearLayout style="@style/SettingsRow">

                <LinearLayout style="@style/SettingsRowCopy">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:text="@string/profile_about_open_source" />

                    <TextView
                        style="@style/SettingsRowSub"
                        android:text="@string/profile_about_osmdroid" />

                    <TextView
                        style="@style/SettingsRowSub"
                        android:text="@string/profile_about_amap" />

                    <TextView
                        style="@style/SettingsRowSub"
                        android:text="@string/profile_about_datav" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:background="@color/border" />

            <LinearLayout style="@style/SettingsRow">

                <LinearLayout style="@style/SettingsRowCopy">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:text="@string/profile_about_developer" />

                    <TextView
                        style="@style/SettingsRowSub"
                        android:text="@string/profile_about_developer_text" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:background="@color/border" />

            <LinearLayout style="@style/SettingsRow">

                <LinearLayout style="@style/SettingsRowCopy">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:text="@string/profile_about_version" />
                </LinearLayout>

                <!-- 版本号在 refresh() 里填（要 BuildConfig.VERSION_NAME），布局不写死 -->
                <TextView
                    android:id="@+id/textAboutVersion"
                    style="@style/SettingsRowValue" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:background="@color/border" />

            <!-- 检查更新：整行可点 → 拉 docs/version.json 比 version_code
                 （App 特有的一行，网页端明确不做更新检查，只留静态版本号文字） -->
            <LinearLayout
                android:id="@+id/rowCheckUpdate"
                style="@style/SettingsRow"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout style="@style/SettingsRowCopy">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:text="@string/profile_about_check_update" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@color/text_tertiary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:background="@color/border" />

            <!-- 公告：整行可点 → 进公告页（ui/NoticeActivity，读 version.json 的 notices）。
                 这一行**不显示未读数**：本页 refresh() 在每次切回 tab 时都跑（onHiddenChanged），
                 为了一枚小红点在这里打网络，与「切 tab 不打网络」的约定冲突；
                 有没有新公告由主页顶部那条横幅负责提示 -->
            <LinearLayout
                android:id="@+id/rowNotice"
                style="@style/SettingsRow"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout style="@style/SettingsRowCopy">

                    <TextView
                        style="@style/SettingsRowTitle"
                        android:text="@string/profile_about_notice" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@color/text_tertiary" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 退出登录 =====
             单独一条：不放在任何分组里（别让它在视觉上跟上面的设置项连成一片），
             文字居中、用危险色。点了先弹确认框（见 ProfileFragment.confirmLogout） -->
        <LinearLayout
            style="@style/SettingsGroup"
            android:layout_marginTop="20dp"
            android:clipToOutline="true">

            <LinearLayout
                android:id="@+id/rowLogout"
                style="@style/SettingsRow"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center">

                <TextView
                    style="@style/SettingsRowTitle"
                    android:layout_width="wrap_content"
                    android:text="@string/profile_logout"
                    android:textColor="@color/destructive" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>