<?xml version="1.0" encoding="utf-8"?>
<!-- 顶栏动作按钮底：36dp 方块 + 1dp sidebar 描边。
     圆角 18dp = 36dp 的一半，也就是正圆：它是方形的图标按钮，
     网页的 .back-link 用 radius-pill、图标按钮（.dialog-close / .theme-toggle）用 radius-full，
     两者在正方形上落出来是同一个形状。
     尺寸若改动，这个值要跟着改成半高，否则会变成圆角方块。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="18dp" />
    <solid android:color="@color/card" />
    <stroke
        android:width="1dp"
        android:color="@color/sidebar_border" />
</shape>
