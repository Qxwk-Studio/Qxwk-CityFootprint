<?xml version="1.0" encoding="utf-8"?>
<!-- 排行行的名次圆（等价网页 .rank-no）：浅底 + 1px 描边、文字用次要色。
     前三名由代码把 backgroundTint 改成主色并转白字（等价网页 .rank-no.top 的高亮）。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/popover" />
    <stroke
        android:width="1dp"
        android:color="@color/border" />
</shape>
