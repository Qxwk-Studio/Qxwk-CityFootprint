<?xml version="1.0" encoding="utf-8"?>
<!-- 列表 / 区块卡片底：圆角 14dp + 1dp 描边（对应网页 .card 的 radius-md，
     变量名省掉前导双连字符的原因见 themes.xml 的卡片样式注释）。
     用于需要「一个卡片装多行」的场景（如足迹列表），MaterialCardView 之外的纯背景版本。
     值与 themes.xml 的 Widget.App.CardView 保持一致，改一处记得改另一处。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="14dp" />
    <solid android:color="@color/card" />
    <stroke
        android:width="1dp"
        android:color="@color/border" />
</shape>
