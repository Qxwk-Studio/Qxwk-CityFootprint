<?xml version="1.0" encoding="utf-8"?>
<!-- 浅色色板。语义命名（bg / fg / card / border …），深色那一套在 values-night/colors.xml，
     只覆盖「深色下确实要变」的那些 token —— 本文件里出现、深色里没有的，就是深色下沿用同一值。

     改主色只改 accent 一处：主题里 appAccent 默认指向它（用户可能在「我的 → 主题色」里换掉）。 -->
<resources>
    <!-- ===== 主色 ===== -->
    <color name="accent">#2563EB</color>          <!-- 默认主色；用户可在「我的 → 主题色」换预设 -->
    <color name="accent_light">#EFF6FF</color>    <!-- 主色的浅底：chip 选中底 / 进度轨道 -->
    <color name="accent_soft_fg">#1D4ED8</color>  <!-- 浅蓝底上的深蓝字 -->
    <color name="on_accent">#FFFFFF</color>       <!-- 主色实底上的文字/图标 -->

    <!-- ===== 面与文字 ===== -->
    <color name="bg">#F8FAFC</color>              <!-- 页面底 -->
    <color name="card">#FFFFFF</color>            <!-- 卡片底 -->
    <color name="fg">#0F172A</color>              <!-- 正文与标题 -->
    <color name="text_secondary">#64748B</color>  <!-- 次要说明 -->
    <color name="muted_fg">#64748B</color>        <!-- 更弱的说明（与 secondary 同值） -->
    <color name="text_tertiary">#64748B</color>   <!-- 辅助文字：与 secondary 同值，层级靠字号与字重承担（浅灰在浅底上读不清） -->
    <color name="muted">#E2E8F0</color>           <!-- 进度轨道 / 开关关闭态轨道 -->
    <color name="popover">#F8FAFC</color>         <!-- 输入框底 / 名次圆底 -->

    <!-- ===== 线 ===== -->
    <color name="border">#E2E8F0</color>          <!-- 卡片描边 / 分隔线 -->
    <color name="input_border">#E2E8F0</color>    <!-- 输入框描边 -->

    <!-- ===== 外壳（顶栏 / 底栏） ===== -->
    <color name="sidebar">#FFFFFF</color>
    <color name="sidebar_fg">#0F172A</color>
    <color name="sidebar_border">#E2E8F0</color>

    <!-- ===== 语义色 ===== -->
    <color name="destructive">#DC2626</color>     <!-- 危险动作 / 表单错误 -->

    <!-- 系统栏兜底：与顶栏同色（themes.xml 用它当 statusBarColor / navigationBarColor） -->
    <color name="window_bg_light">#FFFFFF</color>
    <color name="first_visit">#B45309</color>     <!-- 首访：金色文字/描边 -->
    <color name="first_visit_bg">#FEF3C7</color>  <!-- 首访：金色浅底 -->
    <color name="rank_gold">#B8860B</color>   <!-- 排名第 1：金 -->
    <color name="rank_silver">#8C99A8</color> <!-- 排名第 2：银 -->
    <color name="rank_bronze">#A9663B</color> <!-- 排名第 3：铜 -->

    <color name="badge_cost">#D97706</color>
    <color name="stripe_trip">#2563EB</color>
    <color name="stripe_manual">#34A853</color>
    <color name="stripe_derived">#94A3B8</color>
    <!-- 地图专用色：不复用界面 token，单独调一档，保证陆/水/路与底色拉得开 -->
    <color name="map_bg">#EEF2F6</color>
    <color name="map_land">#E2E8F0</color>
    <color name="map_water">#BFDBFE</color>
    <color name="map_road">#CBD5E1</color>
    <color name="map_province">#94A3B8</color>
</resources>
