<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 应用显示名：启动器图标下、系统「应用信息」里显示的就是它（清单的 android:label 引用的就是这条）。
         只做英文 City Footprint，与网页端 / 通行证登记名一致，不再另设中文名。 -->
    <string name="app_name">City Footprint</string>

    <!-- 底部导航五个 tab 的名字（与 menu/bottom_nav.xml 一一对应）。
         五个 tab 的正文分别对齐网页端：主页=足迹管理页、我的成就=该页成就区、地图=首页地图、全站统计=统计页、我的=个人管理 -->
    <string name="tab_home">主页</string>
    <string name="tab_achievements">我的成就</string>
    <string name="tab_map">地图</string>
    <string name="tab_stats">全站统计</string>
    <string name="tab_profile">我的</string>

    <!-- 登录页 -->
    <string name="login_title">Qxwk 通行证登录</string>
    <string name="login_bar_title">通行证登录</string>
    <string name="login_subtitle">足迹数据与聊天账号共用一套通行证</string>
    <string name="login_account">昵称或邮箱</string>
    <string name="login_password">密码</string>
    <string name="login_submit">登录</string>
    <string name="login_err_account">请输入昵称或邮箱</string>
    <string name="login_err_password">请输入密码</string>
    <string name="login_need_password">该账号还没设置过密码，请先到通行证（account.qxwkstudio.top）设置密码后再登录</string>

    <!-- 我的足迹 -->
    <string name="visits_title">📍 行程记录</string>
    <string name="visits_empty">还没有记录。点右上角「添加足迹」添加第一条</string>
    <string name="visits_add">添加足迹</string>
    <!-- 私密徽章：列表条目与「查看」弹窗共用这一条，文案与网页 .visit-private-badge 一致（🔒 + 不公开） -->
    <string name="visits_private">🔒 不公开</string>
    <!-- 行程条目里「城市 · 时间」那段：分隔点与时间一起给出，避免在代码里拼字符串 -->
    <string name="visits_meta">· %1$s</string>
    <string name="visits_delete_confirm_title">删除这条足迹？</string>
    <string name="visits_delete_confirm_message">删除后无法恢复（%1$s）。</string>
    <!-- 行程条目右侧那两颗只有图标的按钮：文案只给无障碍朗读用（图标本身没有文字） -->
    <string name="visits_share">分享</string>
    <string name="visits_edit">编辑</string>

    <!-- 「查看」弹窗（点行程条目打开，只读；列表里备注只有一行省略，完整的在这里看） -->
    <string name="visits_detail_date">到访时间</string>
    <string name="visits_detail_transport">出行方式</string>
    <string name="visits_detail_note">备注</string>
    <string name="visits_detail_close">关闭</string>

    <!-- 主页顶部的「足迹统计」小卡（对齐网页端 docs/visits.html 的 .visit-stats：
         首行「时间跨度」整行长卡，其余四张每行两个） -->
    <string name="visits_overview_title">📊 足迹统计</string>
    <string name="visits_overview_range">⏳ 时间跨度</string>
    <string name="visits_overview_cities">✈️ 去过城市</string>
    <string name="visits_overview_visits">📍 足迹</string>
    <string name="visits_overview_provinces">🗺️ 省份</string>
    <string name="visits_overview_transport">🚆 最常用出行</string>

    <!-- 新增 / 编辑 -->
    <string name="edit_title_new">添加足迹</string>
    <string name="edit_title_old">编辑足迹</string>
    <string name="edit_city">城市</string>
    <string name="edit_city_hint">点击选择城市</string>
    <!-- 城市栏右侧那颗准心按钮（网页 docs/index.html 的同款按钮，它的 title 就是这句） -->
    <string name="edit_locate">定位到最近的城市</string>
    <string name="edit_date">到访时间（可留空）</string>
    <string name="edit_date_hint">点击选择年 / 月，月份可留空</string>
    <string name="edit_date_year_only">仅年份</string>
    <string name="edit_date_clear">清除</string>
    <string name="edit_note">备注（选填，最多 100 字）</string>
    <!-- 出行方式多选（与网页端 .tp-chip 同一组 code，见 logic/Transport.kt） -->
    <string name="edit_transport">出行方式（可多选）</string>
    <string name="edit_private">仅自己可见</string>
    <string name="edit_private_hint">开启后不出现在公开地图与统计里</string>
    <string name="edit_footnote">城市与坐标来自内置城市表，保存后地图上会自动落点；日期留空表示「去过但记不清了」</string>
    <string name="edit_save">保存</string>
    <string name="edit_delete">删除</string>
    <string name="edit_note_counter">%1$d/100</string>
    <string name="edit_err_city">请选择城市</string>
    <string name="edit_err_date">日期格式应为 2024 或 2024-08（也可以留空）</string>

    <!-- 城市选择 -->
    <string name="city_search_hint">搜索城市名或省份</string>
    <string name="city_empty">没有匹配的城市</string>

    <!-- 定位（编辑页与地图页共用）。提示语对齐网页 docs/index.js：'正在定位…' / '未找到附近城市' /
         '未获得定位权限，请允许定位'。网页的 geoErrorMsg 还分 POSITION_UNAVAILABLE / TIMEOUT 两句，
         App 侧 [LocationManagerCompat] 拿不到位置时只能区分「没开定位」（enabled=false）与「其它」，
         所以合成两句 —— 别为了凑齐三句去猜失败原因 -->
    <string name="locate_locating">正在定位…</string>
    <string name="locate_no_permission">未获得定位权限，请允许定位</string>
    <string name="locate_disabled">定位失败，请检查是否已开启定位（GPS）</string>
    <string name="locate_failed">定位失败，请重试</string>
    <string name="locate_no_city">未找到附近城市</string>

    <!-- 统计（对齐网页 docs/stats.html：四张数字卡 + 城市次数排名 + 成就达成人数） -->
    <string name="stats_total_visits">✈️ 总行程</string>
    <string name="stats_total_cities">🏙️ 总城市</string>
    <string name="stats_total_provinces">🗺️ 覆盖省份</string>
    <string name="stats_total_users">👥 总用户</string>
    <string name="stats_rank_title">🏆 去过的城市次数排名</string>
    <string name="stats_achievements_title">🏆 成就</string>
    <!-- 空态与错误态照抄网页 stats.html 的两句话（不是通用 common_error）；
         排行空态是「全站还没人记过足迹」，跟「我这页没有数据」不是一回事 -->
    <string name="stats_rank_empty">还没有任何足迹，去添加第一座城市吧 ✈️</string>
    <string name="stats_load_failed">统计加载失败，请稍后重试</string>
    <string name="stats_admin_note">👑 管理员视图 · 正在统计全部行程（含私密）</string>

    <!-- 地图 -->
    <string name="map_empty">还没有足迹，先去「足迹」页添加</string>
    <!-- 管理员视图提示（浮在地图右上角，对齐网页 docs/index.html 的 .adminViewNote）。
         网页端 index 只写「👑 管理员视图」，stats 那条才补「· 正在统计全部行程（含私密）」，
         所以这里另给一条串，别复用 stats_admin_note -->
    <string name="map_admin_note">👑 管理员视图</string>
    <!-- 地图右上角那颗定位按钮。网页端颗「我的位置」蓝点是由添加弹窗触发的，App 两页分离，
         得在地图页单独给个入口（见 MapFragment.locate），所以这条文案网页那边没有对应物 -->
    <string name="map_locate">定位我的位置</string>
    <!-- 图例（按用户筛选，对齐网页 docs/index.html 的 .legend）：标题 + 全选 + 每个用户一行。
         标题用与网页 .legend-title 同一份文案（网页「谁的足迹」），两端别各叫一个名字 -->
    <string name="map_legend_title">谁的足迹</string>
    <string name="map_legend_all">全选</string>
    <!-- 折叠箭头：展开时是「可收起」（▾），收起时是「可展开」（▸） -->
    <string name="map_legend_toggle_expanded">▾</string>
    <string name="map_legend_toggle_collapsed">▸</string>
    <!-- 点城市后从底部浮出的明细卡（对齐网页 Leaflet popup 的内容） -->
    <string name="map_city_loading">加载中…</string>
    <string name="map_city_failed">加载失败</string>
    <string name="map_city_empty">没有符合条件的行程</string>
    <string name="map_city_more">仅显示最近 10 条</string>
    <string name="map_city_close">关闭</string>
    <string name="map_city_close_glyph">✕</string>

    <!-- 我的 -->
    <string name="profile_logout">退出登录</string>
    <string name="profile_logout_confirm">退出后本地登录态会被清除，需要重新登录。</string>
    <string name="profile_account_note">登录由「Qxwk 通行证」(account.qxwkstudio.top) 提供，密码不经过足迹后端</string>
    <!-- UID：本地用户 id，对应网页 account.js 的 `'UID：' + s.userId`（那边用等宽字体，这里同） -->
    <string name="profile_uid">UID：%1$d</string>
    <!-- 管理员徽章：网页 account.html 的 #adminBadge（👑 管理员），显隐看 /api/me 的 is_admin -->
    <string name="profile_admin_badge">👑 管理员</string>
    <!-- 头像的无障碍描述（头像本身是通行证给的图，回退时是昵称首字） -->
    <string name="profile_avatar">头像</string>
    <!-- 通行证中心：网页 account.html 那张卡（标题 / 提示 / 按钮三句照抄，两端别各编一套文案） -->
    <string name="profile_passport_title">🎫 通行证中心</string>
    <string name="profile_passport_hint">在通行证中心修改昵称 / 颜色 / 密码、生成邀请码</string>
    <string name="profile_passport_open">打开通行证中心</string>
    <!-- 跳外部浏览器失败（设备上没有任何能开 https 的应用）时的提示 -->
    <string name="profile_passport_failed">没有可打开网页的应用</string>

    <!-- 专属地图颜色：色点右边那行字，与网页 account.html 的 .profile-color-text 同一句
         （色点本身在代码里按通行证主题色画，见 ProfileFragment.colorDot） -->
    <string name="profile_color_label">专属地图颜色</string>

    <!-- 清除缓存卡（网页 account.html 那张）。三句照抄网页，两端别各编一套文案 -->
    <string name="profile_clear_cache_title">🧹 清除缓存</string>
    <string name="profile_clear_cache_hint">清除本机缓存的接口数据与地图边界，不影响登录与足迹</string>
    <string name="profile_clear_cache_btn">清除缓存</string>
    <!-- 清完的提示。网页是在卡片里内联一行 #cacheMsg（带绿色 .ok 样式）显示这句；
         App 全站提示一律用 Toast，也就不必为这一处再往色板里加一档「成功色」 -->
    <string name="profile_clear_cache_done">已清除本机缓存</string>

    <!-- 关于软件卡（网页 account.html 右下角那张） -->
    <string name="profile_about_title">ℹ️ 关于软件</string>
    <string name="profile_about_subtitle">City Footprint · 青翔未阔工作室</string>
    <string name="profile_about_open_source">使用的开源内容</string>
    <!-- 开源内容三条。**第一条不能照抄网页**：网页地图走 Leaflet，App 是 osmdroid，
         各自列各自真正用到的那一个；底图瓦片与边界数据两端同源，照抄 -->
    <string name="profile_about_osmdroid">osmdroid — 地图渲染（Apache-2.0）</string>
    <string name="profile_about_amap">高德地图 — 底图瓦片</string>
    <string name="profile_about_datav">DataV GeoAtlas — 行政区边界数据</string>
    <string name="profile_about_developer">开发者</string>
    <string name="profile_about_developer_text">青翔未阔工作室 · QxwkStudio@outlook.com</string>
    <string name="profile_about_version">版本</string>
    <!-- 版本号：网页把 'v' 显式拼在 APP_VERSION 前面（account.js），这里照同一形态，
         与 CI 注入的 versionName（如 1.3.0）拼出来就是「当前版本 v1.3.0」 -->
    <string name="profile_about_version_text">当前版本 v%1$s</string>

    <!-- 统计页排行行的文案与展开/收起（对齐网页 .rank-item / .rank-toggle） -->
    <string name="stats_rank_people">去过 %1$d 人</string>
    <string name="stats_rank_count">%1$d 次</string>
    <string name="stats_rank_expand">展开查看前 %1$d 名（共 %2$d 座城市）</string>
    <string name="stats_rank_collapse">收起（仅显示前 %1$d 名）</string>
    <string name="stats_rank_total">共 %1$d 座城市</string>

    <!-- 统计页「成就达成人数」（网页同名校） -->
    <string name="stats_achv_count_title">🏅 成就达成人数</string>
    <string name="stats_achv_count_num">%1$d 人</string>

    <!-- 成就页顶部摘要行「已点亮 X / Y」（对齐网页 .achievement-summary）：
         拆成三段是因为网页把中间那个数字加粗并染成主色（.sum-label b），
         Android 要同样的效果就得分开两个 TextView（数字不加千分位、无需格式化串）。
         「/ Y」写成带前导空格的格式串，拼出来就是网页的「X / Y」。 -->
    <string name="achievement_summary_label">已点亮</string>
    <string name="achievement_summary_total">/ %1$d</string>
    <!-- 分类头条右侧的「X/Y」：网页 .category-progress 里斜杠两侧**没有**空格，这里照抄 -->
    <string name="achievement_progress_ratio">%1$d/%2$d</string>
    <!-- 已达成成就右侧那个勾（网页用的是同一个 "✓" 字符） -->
    <string name="achievement_check">✓</string>

    <!-- 通用 -->
    <string name="common_retry">重试</string>
    <string name="common_confirm">确定</string>
    <string name="common_cancel">取消</string>
    <string name="common_delete">删除</string>
    <string name="common_back">返回</string>
    <string name="common_session_expired">登录已过期，请重新登录</string>
    <!-- 兜底文案：异常没带 message 时才用（正常情况下显示的是后端 error 原文） -->
    <string name="common_error">操作失败，请重试</string>
</resources>